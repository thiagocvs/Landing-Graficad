---
import { empresa } from '../data/site';
import Marca from './Marca.astro';

const anio = new Date().getFullYear();

const redes = [
  {
    nombre: 'LinkedIn',
    href: empresa.linkedin,
    path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.4 8.65 21 11 21 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3-2.01 0-2.32 1.57-2.32 3.2V21H9z',
  },
] as const;
---

<footer id="contacto" data-hoja="07" class="border-t border-ink-100">
  <div class="mx-auto max-w-[52rem] px-5 py-20 text-center md:px-10 md:py-24">
    <!-- Marca centrada, con la bajada del logotipo -->
    <a href="#inicio" class="inline-flex" aria-label={`${empresa.nombre} — volver arriba`}>
      <Marca tamano="text-2xl" bajada />
    </a>

    <p class="measure-tight mx-auto mt-6 text-ink-600">
      Impresión de gran formato y montaje para empresas. Del archivo a la fachada, con un
      solo responsable del resultado.
    </p>

    <!-- Datos de contacto en una fila, separados por reglas -->
    <address class="mt-10 grid gap-x-10 gap-y-6 not-italic sm:grid-cols-3">
      <div>
        <p class="type-label text-ink-500">Dirección</p>
        <p class="mt-1.5 text-ink-700">{empresa.direccion}<br />{empresa.ciudad}</p>
      </div>
      <div>
        <p class="type-label text-ink-500">Teléfono</p>
        <a
          href={`tel:${empresa.telefonoHref}`}
          class="mt-1.5 inline-flex min-h-11 items-center text-ink-700 transition-colors duration-200 hover:text-signal"
          >{empresa.telefono}</a
        >
      </div>
      <div>
        <p class="type-label text-ink-500">Email</p>
        <a
          href={`mailto:${empresa.email}`}
          class="mt-1.5 inline-flex min-h-11 items-center text-ink-700 transition-colors duration-200 hover:text-signal"
          >{empresa.email}</a
        >
      </div>
    </address>

    <!-- Redes -->
    <div class="mt-10 flex justify-center gap-3">
      {
        redes.map((red) => (
          <a
            href={red.href}
            class="grid size-11 place-items-center border border-ink-300 text-ink-600 transition-colors duration-200 ease-out-quart hover:border-signal hover:text-signal"
          >
            <span class="sr-only">{empresa.nombre} en {red.nombre}</span>
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
              <path d={red.path} />
            </svg>
          </a>
        ))
      }
      <a
        href={empresa.instagram}
        class="grid size-11 place-items-center border border-ink-300 text-ink-600 transition-colors duration-200 ease-out-quart hover:border-signal hover:text-signal"
      >
        <span class="sr-only">{empresa.nombre} en Instagram</span>
        <svg
          viewBox="0 0 24 24"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
    </div>

    <!-- Cierre: solo los derechos. Sin listas de enlaces. -->
    <p class="type-label mt-14 border-t border-ink-200 pt-6 text-ink-500">
      © {anio} {empresa.razonSocial}. {empresa.lema}.
    </p>
  </div>
</footer>
